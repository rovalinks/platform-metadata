# Project & Infrastructure
PROJECT_ID: platform-metadata-demo
REGION: europe-west2
REGISTRY_BUCKET: platform-metadata-demo-registry
BIGQUERY_DATASET: metadata_governance_dataset
TASK_QUEUE: metadata-remediation
CLOUD_RUN_URL: https://metadata-governance-375142238023.europe-west2.run.app
SERVICE_ACCOUNT_EMAIL: governance-engine-sa@platform-metadata-demo.iam.gserviceaccount.com

# Application Configuration
LOG_LEVEL: WARNING
DRY_RUN: "false"
PRESERVE_EXISTING_LABELS: "true"

# Performance & Tuning
MAX_PARALLEL_WORKERS: "10"
REGISTRY_CACHE_TTL: "60"
DISCOVERY_RETENTION_DAYS: "10"
REMEDIATION_BATCH_SIZE: "2"

# Governance Exclusions
EXCLUDED_BUCKETS: "platform-metadata-demo-registry,platform-metadata-demo_cloudbuild,platform-metadata-demo-tfstate"